{
  "name": "gambit",
  "private": true,
  "version": "1.25.9",
  "type": "module",
  "description": "GAMBIT — chess that levels up. Characters gain special moves and shields; new pieces unlock over time. Deterministic, UI-free core (command/event sim with replay) for cross-platform reuse.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run schaukammer",
    "build:single": "vite build --config vite.single.config.js && node scripts/singlefile-iife.mjs",
    "preview": "esbuild preview_assets.jsx --bundle --platform=node --jsx=automatic --outfile=.preview.mjs --format=esm --loader:.png=dataurl --external:react --external:react-dom --log-level=silent && node .preview.mjs",
    "test": "node tools/pruefe-buttons.mjs && node tools/pruefe-dateinamen.mjs && node test_kontrast.mjs && node test_core.mjs && node test_engine.mjs && node test_progression.mjs && node test_features.mjs && node test_buende.mjs && node test_decks.mjs && node test_sperren.mjs && node test_kapitel1.mjs && node test_maps.mjs && node test_boards.mjs && node test_combat.mjs && node test_monster_gaben.mjs && node test_boss.mjs && node test_balance.mjs && node test_net.mjs && npm run smoke && npm run ui && node test_story.mjs && node test_saves.mjs && node test_worker.mjs && node test_dragon.mjs && node test_campaign_smoke.mjs && node test_sonderzuege.mjs && node test_anim.mjs && node test_zauber.mjs",
    "smoke": "esbuild smoke_render.jsx --bundle --platform=node --jsx=automatic --outfile=.smoke.mjs --format=esm --external:react --external:react-dom --loader:.jpg=dataurl --loader:.png=dataurl --loader:.webp=dataurl --loader:.mp3=dataurl --loader:.webm=dataurl --loader:.css=empty --log-level=warning && node .smoke.mjs",
    "art": "node scripts/build-art.mjs",
    "prebuild": "npm run art",
    "prebuild:single": "npm run art",
    "pretest": "npm run art",
    "presmoke": "npm run art",
    "prepreview": "npm run art",
    "predev": "npm run art",
    "map:svg": "node scripts/export-map.mjs",
    "deploy:site": "node scripts/deploy-pages.mjs",
    "ui": "esbuild test_ui.jsx --bundle --platform=node --jsx=automatic --outfile=.uitest.mjs --format=esm --external:react --external:react-dom --loader:.jpg=dataurl --loader:.png=dataurl --loader:.webp=dataurl --loader:.mp3=dataurl --loader:.webm=dataurl --loader:.css=empty && node .uitest.mjs",
    "ui:knoepfe": "node tools/messe-knoepfe.mjs --pruefen",
    "schaukammer": "node tools/baue-schaukammer.mjs",
    "vorschau": "node -e \"process.exit(0)\" && python3 tools/baue-vorschau.py src/app/ui/assets public/schau-klein && python3 tools/baue-vorschau.py archiv/bilder public/bildarchiv-klein && python3 tools/ordne-originale.py",
    "pruefe:karte": "npx esbuild tools/pruefe-karteneinstieg.mjs --bundle --platform=node --jsx=automatic --outfile=.pk.mjs --format=esm --external:react --external:react-dom --external:jsdom --loader:.jpg=dataurl --loader:.png=dataurl --loader:.webp=dataurl --loader:.mp3=dataurl --loader:.webm=dataurl --loader:.css=empty --log-level=warning && node .pk.mjs",
    "pruefe:hub": "npx esbuild render_hub.mjs --bundle --platform=node --jsx=automatic --outfile=.rh.mjs --format=esm --external:react --external:react-dom --external:jsdom --loader:.jpg=dataurl --loader:.png=dataurl --loader:.webp=dataurl --loader:.mp3=dataurl --loader:.webm=dataurl --loader:.css=empty --log-level=warning && node .rh.mjs",
    "pruefe:fluss": "node tools/pruefe-textfluss.mjs"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.2.6",
    "@fontsource/spectral": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
